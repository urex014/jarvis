[Unit]
Description=J.A.R.V.I.S. agy Agent Bridge Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/cryptic/projects/jarvis
ExecStart=/home/cryptic/projects/jarvis/.venv/bin/python /home/cryptic/projects/jarvis/daemon/agy_bridge.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
